# Required — your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Required — any email address. OpenAlex and Unpaywall ask for one so they
# can contact you if your requests misbehave. It is not published anywhere.
CONTACT_EMAIL=you@example.com

# Optional — which Claude model to use
CLAUDE_MODEL=claude-sonnet-5

# Optional — caching. Without these, caching falls back to in-memory,
# which resets whenever the server restarts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — enables the journalism tier. Free tier available at brave.com/search/api
BRAVE_API_KEY=
